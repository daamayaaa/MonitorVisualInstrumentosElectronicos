<?xml version="1.0"?>

<project name="MonitorVisualInstrumentosElectronicos" default="dist" basedir=".">
	<description>
		Proyecto de Monitoreo Visual de Instrumentos Electronicos
	</description>
	<!-- creo propiedades -->
	<property name="version" value="1.0" />
	<property name="src" location="src" />
	<property name="lib" location="lib" />
	<property name="build" location="build" />
	<property name="imagenes" location="imagenes" />
	<property name="conf" location="conf" />
	<property name="doc" location="doc" />
	<property name="dist" location="dist" />
	<property name="help" location="help" />
	<property name="resources" location="resources" />

	<path id="path.libs">
		<pathelement location="." />
		<fileset dir="lib">
			<include name="**/*.jar" />
		</fileset>
	</path>

	<target name="delete-jar">
		<echo> ************ SE BORRA EL JAR DEL PROYECYO ***************** </echo>
		<delete>
			<fileset dir="dist" includes="*.jar"/>
		</delete>
	</target>

	<target name="clean" description="clean up">
		<echo> ************ SE LIMPIA EL PROYECYO ***************** </echo>
		<delete dir="${build}" />
		<echo message="Limpieza exitosa del proyecto."/>
	</target>

	<target name="init" depends="clean">
		<echo> ************ EJECUTANDO INIT ***************** </echo>
		<tstamp />
		<mkdir dir="${build}" />
	    <mkdir dir="${doc}" />
		<copy todir="${build}">
			<fileset dir="${src}">
				<include name="**/*" />
				<exclude name="**/*.java" />
			</fileset>
		</copy>

		<copy todir="${build}/imagenes">
			<fileset dir="${imagenes}">
				<include name="**/*.png" />
				<include name="**/*.jpg" />
			</fileset>
		</copy>

		<copy todir="${build}/conf">
			<fileset dir="${conf}">
				<include name="**/*.properties" />
			</fileset>
		</copy>
		<echo message="Ejecución de la inicialización exitosa."/>
	</target>

	<target name="compile" depends="init" description="Compila el codigo del proyecto.">
		<echo> [INFO] Compilando el programa con todas las dependencias. </echo>
		<javac includeantruntime="false" srcdir="${src}" destdir="${build}" source="1.8" failonerror="true" verbose="false" debug="true" fork="true" deprecation="off" optimize="true" memoryinitialsize="512m" memorymaximumsize="1024m" >
			<compilerarg line="-J-Xms512m -J-Xmx1024m" />
			<compilerarg value= "-Xlint:deprecation" />
			<compilerarg value= "-Xlint:unchecked" />
			<classpath refid="path.libs" />
		</javac>
		<echo message="Compilación exitosa del programa con todas las dependencias. "/>
	</target>

	<target name="dist" depends="compile" description="Genera el entregable del proyecto.">
		<echo> [INFO] Generando el JAR del proyecto. </echo>
		<jar jarfile="dist/MonitorVisualInstrumentosElectronicos.jar" basedir="${build}" update="yes" compress="true">
			<manifest>
				<attribute name="Built-By" value="${user.name}" />
				<attribute name="Main-Class" value="com.damaya.proyinv.cliente.MonitorVisualInstrumentosElectronicos" />
				<attribute name="Class-Path" value="." />
			</manifest>
			<zipfileset src="lib/commons-dbcp2-2.13.0.jar" excludes="META-INF/*" />
			<zipfileset src="lib/commons-io-2.4.jar" excludes="META-INF/*" />
			<zipfileset src="lib/commons-lang-2.1.jar" excludes="META-INF/*" />
			<zipfileset src="lib/commons-math-2.0.jar" excludes="META-INF/*" />
			<zipfileset src="lib/itextpdf-5.5.5.jar" excludes="META-INF/*" />
			<zipfileset src="lib/jcommon-1.0.23.jar" excludes="META-INF/*" />
			<zipfileset src="lib/jfreechart-1.0.19.jar" excludes="META-INF/*" />
			<zipfileset src="lib/log4j.jar" excludes="META-INF/*" />
			<zipfileset src="lib/poi-3.7-20101029.jar" excludes="META-INF/*" />
			<zipfileset src="lib/poi-scratchpad-3.7-20101029.jar" excludes="META-INF/*" />
			<zipfileset src="lib/RXTXcomm.jar" excludes="META-INF/*" />
			<zipfileset src="lib/slf4j-api-1.7.7.jar" excludes="META-INF/*" />
			<zipfileset src="lib/slf4j-jdk14-1.7.7.jar" excludes="META-INF/*" />
			<zipfileset src="lib/substance-4.3.jar" excludes="META-INF/*" />
			<zipfileset src="lib/javahelp-2.0.02.jar" excludes="META-INF/*" />
		</jar>
		<echo message="Generación exitosa del ejecutable del proyecto. "/>
	</target>

	<target name="doc" depends="init" description="Genera la documentación del proyecto.">
		<echo> [INFO] Generando la documentación del código del proyecto. </echo>
		<delete dir="${doc.dir}" />
		<mkdir dir="${doc}" />
		<javadoc classpathref="classpath" destdir="${doc}" sourcepath="${src}" version="true" windowtitle="Monitoreo del Comportamiento de los Datos Obtenidos de Varios Instrumentos Electrónicos">
			<packageset dir="${src}" defaultexcludes="yes">
			</packageset>
			<group title="Paquete Principal" packages="com.damaya.proyinv.*"/>
		</javadoc>
		<echo message="Documetación Javadoc generada exitosamente."/>
	</target>

	<target name="clean-build" depends="clean, compile, dist">
		<echo> [INFO] Construyendo el artefacto de despliegue. </echo>
	</target>

	<target name="main" depends="clean-build"/>

</project>